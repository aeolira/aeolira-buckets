        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1152/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "08c8b8d23c7a36d3f8846450b2dccba218eb51ff352f6bc246dd38583978657e"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
