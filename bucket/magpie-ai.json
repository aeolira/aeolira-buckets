        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1159/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "89c28b8fc8d646dbc9d5d28e519b74f23c300abc524e112706d51559aa4e8d2b"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
