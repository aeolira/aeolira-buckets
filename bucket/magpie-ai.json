            "hash": "f17cc725898a2e70812b7a40b25d283621d596d1eaee70976b9b74235c84a559"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1097/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "92f519f0abfe9aa480c4658b1f63f6f231588940a8656afaf33953d5fc990066"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
