            "hash": "426200b0845bc5f18e4afce1391fb29716fed2037db6ac7140b533d7917f7e09"
        },
        "arm64": {
            "url": "https://github.com/yetone/magpie-releases/releases/download/v0.1.1202/magpie-windows-arm64.exe#/magpie.exe",
            "hash": "e281d9795fe8a96dcb93e59ae92a6e5c92e0859127f1971c6572499aa01b8d1f"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -LiteralPath \"$persist_dir\\data\\settings.json\" -PathType Leaf)) {",
        "    ensure \"$dir\\data\" | Out-Null",
        "    @{ noAutoUpdate = $true } | ConvertTo-Json | Set-Content -LiteralPath \"$dir\\data\\settings.json\" -Force -Encoding ASCII",
        "}"
    ],
    "shortcuts": [
        [
            "magpie.exe",
            "Magpie"
        ]
    ],
    "persist": "data",
    "checkver": {
        "github": "https://github.com/yetone/magpie-releases"
    },
    "autoupdate": {
